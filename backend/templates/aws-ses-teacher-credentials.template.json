</td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:24px 24px 10px 24px;\">\n              <p style=\"margin:0 0 8px 0;font-size:28px;font-weight:800;color:#111827;\">Dear {{teacher_name}},</p>\n              <p style=\"margin:0;font-size:15px;line-height:1.6;color:#374151;\">{{body_intro}}</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:0 24px 12px 24px;\">\n              <div style=\"display:inline-block;padding:7px 12px;border-radius:999px;background:#EAF2FF;color:#0040A1;font-size:12px;font-weight:700;letter-spacing:0.03em;\">Sign-in details</div>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:0 24px 12px 24px;\">\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border:1px solid #E8EEF8;background:#F8FAFE;border-radius:14px;\">\n                <tr>\n                  <td style=\"padding:16px 18px;\">\n                    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n                      <tr>\n                        <td style=\"padding:8px 0;width:42%;font-size:13px;color:#6b7280;font-weight:600;\">Sign-in email</td>\n                        <td style=\"padding:8px 0;font-size:14px;color:#0040A1;font-weight:700;\">{{teacher_email}}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:8px 0;width:42%;font-size:13px;color:#6b7280;font-weight:600;\">Temporary password</td>\n                        <td style=\"padding:8px 0;font-size:14px;color:#111827;font-weight:700;letter-spacing:0.06em;\">{{temporary_password}}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:8px 0;width:42%;font-size:13px;color:#6b7280;font-weight:600;\">Grade</td>\n                        <td style=\"padding:8px 0;font-size:14px;color:#111827;font-weight:700;\">{{grade}}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:8px 0;width:42%;font-size:13px;color:#6b7280;font-weight:600;\">Batch ID</td>\n                        <td style=\"padding:8px 0;font-size:14px;color:#111827;font-weight:700;\">{{batch_id}}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:8px 0;width:42%;font-size:13px;color:#6b7280;font-weight:600;\">Batch name</td>\n                        <td style=\"padding:8px 0;font-size:14px;color:#111827;font-weight:700;\">{{batch_name}}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:0 24px 16px 24px;\">\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-radius:12px;background:#FFF9E8;border:1px solid #F0D772;\">\n                <tr>\n                  <td style=\"padding:14px 16px;font-size:14px;line-height:1.55;color:#544600;font-weight:600;\">{{alert_message}}</td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:0 24px 26px 24px;\">\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-radius:12px;background:#111827;\">\n                <tr>\n                  <td style=\"padding:14px 16px;\">\n                    <p style=\"margin:0;font-size:12px;line-height:1.6;color:#d1d5db;\">{{footer_legal}}</p>\n                    <p style=\"margin:10px 0 0;font-size:12px;line-height:1.6;color:#9ca3af;\">{{support_text}}</p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n        </table>\n      </td>