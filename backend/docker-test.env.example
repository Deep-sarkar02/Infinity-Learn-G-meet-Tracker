# Optional: copy to backend/.env.docker for Docker-only overrides (all keys optional).
# DATABASE_URL must point at your hosted Postgres (e.g. Neon) in backend/.env or .env.production.
# Example overrides:
#   JWT_SECRET=change-me-to-a-long-random-string-for-docker-test
#   JWT_EXPIRES_IN=1d
#   BOOKING_WINDOW_DAYS=7
