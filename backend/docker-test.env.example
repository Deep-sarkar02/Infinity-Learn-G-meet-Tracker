# For local Docker Compose with bundled Postgres (repo root: docker compose --profile bundled-db …).
# Copy this file to .env.docker in the same folder (gitignored):
#   Windows: copy docker-test.env.example .env.docker
# Set at least JWT_SECRET. DATABASE_URL targets the `postgres` service on the Docker network.

JWT_SECRET=change-me-to-a-long-random-string-for-docker-test
JWT_EXPIRES_IN=1d
BOOKING_WINDOW_DAYS=7
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/meeting_reservation?schema=public