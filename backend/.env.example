PORT=5000
NODE_ENV=development
# PostgreSQL — required at runtime (Prisma).
# Example: postgresql://postgres:postgres@127.0.0.1:5432/meeting_reservation?schema=public
DATABASE_URL=
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=1d
BOOKING_WINDOW_DAYS=7

# --- Amazon SES (teacher welcome / password reset only; templated SendEmail — see backend/templates/aws-ses-teacher-credentials.template.json)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional alternate names (used if AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are empty):
# AWS_NOTIF_ACCESS_KEY=
# AWS_NOTIF_SECRET_KEY=
# Verified identity in SES (can include display name): "Infinity Learn <noreply@yourdomain.com>"
SES_FROM_EMAIL_ADDRESS=
# Optional; falls back to SES_FROM_EMAIL_ADDRESS
# EMAIL_FROM=
# Must exist in SES with same name as TemplateName in the JSON file (default below)
# SES_TEACHER_CREDENTIALS_TEMPLATE_NAME=INFINITY_LEARN_TEACHER_CREDENTIALS
# On EC2/ECS with IAM role for SES, omit keys and set:
# SES_USE_DEFAULT_CREDENTIAL_CHAIN=true

# Gupshup WhatsApp — optional; roster open-booking confirmed → parent mobile only (no cancel/reschedule WhatsApp).
# POST …/wa/api/v1/template/msg with template={"id":"…","params":[date, start, end, meetLink]} — NOT /msg (plain text).
# GUPSHUP_TEMPLATE_NAME is usually the template UUID from Gupshup.
GUPSHUP_ENABLED=false
GUPSHUP_API_KEY=
GUPSHUP_WA_SOURCE=917000000000
GUPSHUP_SRC_NAME=
GUPSHUP_TEMPLATE_NAME=
GUPSHUP_TEMPLATE_LANG=en
# GUPSHUP_API_URL=https://api.gupshup.io/wa/api/v1/template/msg
# Optional: real Meet URL for npm run gupshup:test (slot 4)
# GUPSHUP_TEST_LINK_URL=https://meet.google.com/xxx-xxxx-xxx

# HTML email branding (logo must be HTTPS and reachable by recipients' mail clients)
EMAIL_BRAND_NAME=Infinity Learn
# Optional: full HTTPS URL to an image for SES template {{logo_url}}. Use a normal https URL — Gmail does not show data: / base64 images in email.
# If empty, APP_PUBLIC_URL + /il-logo.png is used when APP_PUBLIC_URL is set (your frontend nginx serves public/il-logo.png).
# Or point EMAIL_LOGO_URL at this API: https://<your-api-host>/public/il-logo.png
# SES_LOGO_TEMPLATE_DATA_URI=true — rare; embeds a data URI (often blocked in Gmail; for testing only).
EMAIL_LOGO_URL=
# Optional: absolute path to logo file for CID embedding (overrides default backend/assets/il-logo.png)
EMAIL_LOGO_PATH=
# Optional. If unset, teacher SES mail shows: "For help, contact your administrator."
# EMAIL_SUPPORT_EMAIL=support@yourdomain.com
# Frontend base URL (no trailing slash). Used for "Open portal" links and, when EMAIL_LOGO_URL is empty, for the email header logo
APP_PUBLIC_URL=

# Production CORS: comma-separated browser origins allowed to call the API (e.g. https://app.example.com).
# In development, http(s)://localhost and 127.0.0.1 on any port are allowed automatically.
# CORS_ORIGINS=

# Google Calendar/Meet auth mode: oauth | service_account
GOOGLE_AUTH_MODE=oauth
# Calendar used for event creation/deletion. "primary" works with OAuth user auth
# and with Service Account + DWD impersonation.
GOOGLE_CALENDAR_ID=primary

# OAuth mode (existing flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Authorized redirect URIs exactly. OAuth Playground uses:
# https://developers.google.com/oauthplayground (no trailing slash; see Playground settings text).
# If Google shows redirect_uri_mismatch, open "error details" on the error page and add that exact URI.
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=

# Service account mode (GOOGLE_AUTH_MODE=service_account)
# Prod / Docker: put the whole key in env (no host path in the container).
# From backend/: npm run env:google-service-account-json
# Paste the printed GOOGLE_SERVICE_ACCOUNT_JSON=... line below, then leave KEY_PATH empty.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local only: path to JSON on your machine (Windows paths break in Linux containers).
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
# Google Workspace domain-wide delegation — mailbox to impersonate for Calendar/Meet
GOOGLE_IMPERSONATE_USER=

# LSQ post-meeting artifact sync (recording + transcript)
# Background artifact poller (default on). Set to false to disable.
LSQ_SYNC_ENABLED=true
LSQ_BASE_URL=https://lsqservice.infinitylearn.com
LSQ_SERVICE_EMAIL=infinitylearn.cs@wizklub.com
# Required by LSQ service
LSQ_API_SECRET_HEADER=X-Api-Secret
LSQ_API_SECRET=
# Start fetching only after this many minutes past session end-time (default 1). Any booking status; chase window uses LSQ_ARTIFACTS_UNAVAILABLE_AFTER_HOURS from endTime.
LSQ_SYNC_DELAY_MINUTES_AFTER_END=1
# Poll loop while backend is up — default 1800000 = every 30 minutes (min enforced in code: 60s)
LSQ_SYNC_POLL_MS=1800000
# Same booking can be hit again after this many minutes (default 1)
LSQ_SYNC_RETRY_MINUTES=1
LSQ_SYNC_MAX_PER_RUN=40
LSQ_SYNC_REQUEST_TIMEOUT_MS=20000
# Hours after session end: if recording and transcript are still both missing, mark not available and stop retries (default 24).
LSQ_ARTIFACTS_UNAVAILABLE_AFTER_HOURS=24

# LeadSquared ProspectActivity CreateCustom — roster / open booking only (non-blocking; booking succeeds if LSQ fails).
# Activity Fields: mx_Custom_1–10 as today; mx_Custom_11 = Google Meet link for the booking.
# Base URL = API host + /v2 only (no trailing slash, no /ProspectActivity… — that segment is appended in code). Example: https://api-in21.leadsquared.com/v2
LSQ_PROSPECT_ACTIVITY_ENABLED=false
LSQ_PROSPECT_ACTIVITY_BASE_URL=
# If the key contains "$" (e.g. u$xxxx…), Docker Compose env_file treats "$" as interpolation — the key is corrupted and LSQ returns 401 / Invalid User Details. In backend/.env use "$$" for each literal "$" (example: u$$r04d2cf…).
LSQ_PROSPECT_ACTIVITY_ACCESS_KEY=
LSQ_PROSPECT_ACTIVITY_SECRET_KEY=
# ActivityEvent id in LeadSquared (default 223)
LSQ_PROSPECT_ACTIVITY_EVENT_ID=223
LSQ_PROSPECT_ACTIVITY_TIMEOUT_MS=15000
# Dev: include LeadSquared CreateCustom JSON + HTTP outcome in POST /public/bookings (browser console). Waits for LSQ before responding (slightly slower). No keys or URL.
LSQ_PROSPECT_ACTIVITY_CLIENT_DEBUG=false
# Dev: log the same JSON body on the server at info (Docker / terminal).
LSQ_PROSPECT_ACTIVITY_SERVER_LOG_PAYLOAD=false
# Optional: country code digits for SearchBy Phone (e.g. 91 for India). If roster mobile is 10 digits, Phone becomes 91XXXXXXXXXX.
# LSQ_PROSPECT_ACTIVITY_PHONE_PREFIX=91
# Optional: ActivityDateTime uses session start capped to "now" (UTC in API); slot stays in mx_Custom_5/6/10 (IST). Default false = ActivityDateTime is current instant UTC.
# LSQ_PROSPECT_ACTIVITY_USE_SESSION_START_FOR_ACTIVITY_DATETIME=false

# Optional: admin seed — run: npm run seed:admin
# Defaults if unset: admin@infinitylearn.local / Admin123! (change in production)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
# Set to true to reset password for existing admin (same SEED_ADMIN_EMAIL)
SEED_FORCE=
