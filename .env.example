# Optional: place a copy as `.env` in this same folder (next to docker-compose.yml).
# Docker Compose loads it into the backend container (see docker-compose.yml env_file).
# You can instead use only backend/.env — either way DATABASE_URL must be set for Prisma.
#
# Example (managed Postgres / Neon / RDS):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
