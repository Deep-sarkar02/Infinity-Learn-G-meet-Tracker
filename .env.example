# Infinity Learn G-Meet Tracker — single environment file (repo root).
# Copy to `.env` in this same folder:  cp .env.example .env
# Used by: backend API, npm scripts, Vite (frontend dev), and Docker Compose.
#
# If a value contains "$", escape as "$$" in this file when using Docker Compose
# (e.g. LeadSquared keys like u$… → u$$r04d2cf…).

# --- Docker Compose
FRONTEND_PORT=5176
# SKIP_PRISMA_PUSH=1

# --- Frontend (Vite dev; production Docker build uses Dockerfile ARG VITE_API_BASE_URL)
VITE_API_BASE_URL=/api/v1
# Must match LSQ_ARTIFACTS_UNAVAILABLE_AFTER_HOURS (admin “not available” hints).
VITE_LSQ_ARTIFACTS_UNAVAILABLE_AFTER_HOURS=24

# --- Backend
PORT=5000
NODE_ENV=development
# PostgreSQL — required at runtime (Prisma).
# Example: postgresql://postgres:postgres@127.0.0.1:5432/meeting_reservation?schema=public
DATABASE_URL=
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=10d
BOOKING_WINDOW_DAYS=7

# --- Amazon SES (teacher welcome / password reset only; templated SendEmail — see backend/templates/aws-ses-teacher-credentials.template.json)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional alternate names (used if AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are empty):
# AWS_NOTIF_ACCESS_KEY=
# AWS_NOTIF_SECRET_KEY=
# Verified identity in SES (can include display name): "Infinity Learn <noreply@yourdomain.com>"
SES_FROM_EMAIL_ADDRESS=
# Optional; falls back to SES_FROM_EMAIL_ADDRESS
# EMAIL_FROM=
# Must exist in SES with same name as TemplateName in the JSON file (default below)
# SES_TEACHER_CREDENTIALS_TEMPLATE_NAME=INFINITY_LEARN_TEACHER_CREDENTIALS
# On EC2/ECS with IAM role for SES, omit keys and set:
# SES_USE_DEFAULT_CREDENTIAL_CHAIN=true

# Gupshup WhatsApp — optional; roster open-booking confirmed → parent mobile only (no cancel/reschedule WhatsApp).
GUPSHUP_ENABLED=false
GUPSHUP_API_KEY=
GUPSHUP_WA_SOURCE=917000000000
GUPSHUP_SRC_NAME=
GUPSHUP_TEMPLATE_NAME=
GUPSHUP_TEMPLATE_LANG=en
# GUPSHUP_API_URL=https://api.gupshup.io/wa/api/v1/template/msg
# Optional: real Meet URL for npm run gupshup:test (slot 4)
# GUPSHUP_TEST_LINK_URL=https://meet.google.com/xxx-xxxx-xxx

# HTML email branding (logo must be HTTPS and reachable by recipients' mail clients)
EMAIL_BRAND_NAME=Infinity Learn
EMAIL_LOGO_URL=
# Optional: absolute path to logo file for CID embedding (overrides default backend/assets/il-logo.png)
EMAIL_LOGO_PATH=
# EMAIL_SUPPORT_EMAIL=support@yourdomain.com
# Frontend base URL (no trailing slash). Used for email links and default logo URL when EMAIL_LOGO_URL is empty
APP_PUBLIC_URL=

# Production CORS: comma-separated browser origins allowed to call the API (e.g. https://cs.infinitylearn.com).
# In development, http(s)://localhost and 127.0.0.1 on any port are allowed automatically.
# CORS_ORIGINS=

# --- API docs (Swagger UI at /api/v1/docs, raw spec at /api/v1/docs/openapi.json)
SWAGGER_ENABLED=true
# SWAGGER_USER=docs
# SWAGGER_PASSWORD=change-me

# Google Calendar/Meet auth mode: oauth | service_account
GOOGLE_AUTH_MODE=oauth
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=
# Prod / Docker: paste whole key JSON on one line (from backend/: npm run env:google-service-account-json)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_IMPERSONATE_USER=

# LSQ post-meeting artifact sync (recording + transcript)
LSQ_SYNC_ENABLED=true
LSQ_BASE_URL=https://lsqservice.infinitylearn.com
LSQ_SERVICE_EMAIL=infinitylearn.cs@wizklub.com
LSQ_API_SECRET_HEADER=X-Api-Secret
LSQ_API_SECRET=
LSQ_SYNC_DELAY_MINUTES_AFTER_END=1
LSQ_SYNC_POLL_MS=1800000
LSQ_SYNC_RETRY_MINUTES=1
LSQ_SYNC_MAX_PER_RUN=40
LSQ_SYNC_REQUEST_TIMEOUT_MS=20000
LSQ_ARTIFACTS_UNAVAILABLE_AFTER_HOURS=24

# LeadSquared ProspectActivity CreateCustom — roster / open booking only
LSQ_PROSPECT_ACTIVITY_ENABLED=false
LSQ_PROSPECT_ACTIVITY_BASE_URL=
# Escape $ as $$ for Docker Compose (example: u$$r04d2cf…)
LSQ_PROSPECT_ACTIVITY_ACCESS_KEY=
LSQ_PROSPECT_ACTIVITY_SECRET_KEY=
LSQ_PROSPECT_ACTIVITY_EVENT_ID=223
LSQ_PROSPECT_ACTIVITY_TIMEOUT_MS=15000
LSQ_PROSPECT_ACTIVITY_CLIENT_DEBUG=false
LSQ_PROSPECT_ACTIVITY_SERVER_LOG_PAYLOAD=false
# LSQ_PROSPECT_ACTIVITY_PHONE_PREFIX=91

# Optional: admin seed — run from backend/: npm run seed:admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_FORCE=
